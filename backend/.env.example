# Bu faylni ".env" nomi bilan nusxalab, o'z qiymatlaringizni qo'ying.
# .env faylni hech kimga yubormang va git'ga qo'shmang — token maxfiy.
#
# Quyida IKKI to'plam bor: ishlab chiqish (localhost) va ishlab chiqarish
# (aql-zone.uz). Kerakligini oching, keragi yo'qini izohda qoldiring.

# BotFather bergan token. Namuna: 1234567890:AAH...xyz
# Bo'sh qoldirsangiz Telegram orqali kirish o'chadi, qolgan hammasi ishlayveradi.
BOT_TOKEN=

# Bot nomi (@ belgisisiz). Ikki joyda ishlatiladi:
#   - bot xabarlarining matnida,
#   - saytdagi "Telegram bilan kirish" tugmasida — u odamni t.me/<bot> ga
#     olib boradi.
#
# BotFather'da /setdomain qilish SHART EMAS: kirish Login Widget orqali
# emas, botning o'zi yuboradigan bir martalik havola orqali bo'ladi.
BOT_USERNAME=

# Django imzo kaliti. Ishlab chiqarishda ALBATTA o'zgartiring:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=dev-only-insecure-key-almashtiring

# Ishlab chiqarishda 0 qiling. DEBUG=1 bo'lsa xato sahifasi kodni va
# sozlamalarni to'liq ko'rsatadi — ochiq internetda bu xavfli.
DEBUG=1

# Qaysi domendan so'rov qabul qilinadi. Vergul bilan.
# Ishlab chiqarishda "*" QOLDIRMANG — aniq domenni yozing.
#   ALLOWED_HOSTS=aql-zone.uz,www.aql-zone.uz
ALLOWED_HOSTS=*

# HTTPS ostidagi POST so'rovlar uchun. Sxema bilan birga yoziladi.
#   CSRF_TRUSTED_ORIGINS=https://aql-zone.uz,https://www.aql-zone.uz
# Sinov tunneli uchun: https://abc.trycloudflare.com
CSRF_TRUSTED_ORIGINS=

# Bot Mini App'ni qaysi manzilda ochsin. HTTPS majburiy — Telegram
# boshqasini qabul qilmaydi. Bo'sh bo'lsa bot ilova tugmasini ko'rsatmaydi.
#   MINI_APP_URL=https://aql-zone.uz
MINI_APP_URL=

# Saytning ochiq manzili. Bot «✅ Saytga kirish» havolasini shu manzil
# bilan yasaydi: {SAYT_URL}/kirish/<kod>.
#
# BUSIZ TELEGRAM ORQALI KIRISH ISHLAMAYDI — bot havola o'rniga faqat
# raqam so'raydi va buni ishga tushganda ogohlantirib aytadi.
#
# Bo'sh bo'lsa MINI_APP_URL ishlatiladi: ko'p holatda ikkalasi bir xil va
# bitta qiymat yozib qutulasiz.
#   SAYT_URL=https://aql-zone.uz
SAYT_URL=

# React ilovaning yig'ilgan nusxasi (npm run build natijasi)
# FRONTEND_DIST=../frontend/dist

# Baza fayli
# DB_FILE=az-data.sqlite3

# Mobil ilova boshqa origin'dan chaqiradi. Cookie yo'q, himoya Bearer token orqali.
CORS_ALLOW_ORIGIN=*

# ------------------------------------------------------------- ovoz
# O'zbekcha talaffuz (TTS) — Aisha, aisha.group.
#
# Kichkintoylar bo'limi (2–5 yosh) busiz JIM ishlaydi: rasmlar va
# o'yin joyida qoladi, lekin ilova nomlarni aytmaydi. Uch yoshli bola
# esa yozuvni o'qiy olmaydi, ya'ni bo'lim ma'nosining yarmi ovozda.
#
# Kalit: https://space.aisha.group/api-keys
#
# Xarajat cheklangan: faqat `backend/core/lugat/*.txt` dagi matn
# yasaladi (butun lug'at ~860 belgi, bir marta) va natija abadiy
# keshlanadi. Batafsil — OVOZ-README.md.
AISHA_KEY=

# Ovoz, kayfiyat va tezlik. Uchalasi ham fayl xeshiga kiradi —
# almashtirilsa eski fayllar o'z-o'zidan ishlatilmay qoladi va
# `manage.py ovoz` ni qayta yurgizish kerak bo'ladi.
#
# Kayfiyat "Neutral": "Cheerful" da ohang ko'tarilib-tushib turadi va
# o'zbekcha talaffuzda bu yot aksent bo'lib sezilardi.
# AISHA_MODEL=Gulnoza
# AISHA_KAYFIYAT=Neutral
# AISHA_TEZLIK=0.9
# Maqtov so'zi ("Barakalla!") sekinroq — yakka undov shoshib o'qiladi
# va oxirgi bo'g'in yutilib ketadi.
# AISHA_TEZLIK_MAQTOV=0.8

# Yasalgan fayllar qayerda yotadi. Docker'da bu volume (/data/ovoz) —
# konteyner qayta qurilganda kesh saqlanishi kerak.
# OVOZ_KESH=/data/ovoz

# Bir kunda eng ko'pi shuncha BELGI yangidan yasaladi (0 — cheksiz).
# OVOZ_KUNLIK_BELGI=20000

# ------------------------------------------------------------ kanal
# Ilova ochilgandan bir necha soniya keyin "Telegram kanalimizga
# qo'shiling" oynasi chiqadi. A'zo bo'lganga ko'rsatilmaydi.
#
# MUHIM: bot o'sha kanalda ADMINISTRATOR bo'lishi shart — a'zolikni
# faqat admin so'ray oladi. Bo'sh qoldirilsa oyna umuman chiqmaydi.
#   KANAL=AqlZoneUz
KANAL=

# ------------------------------------------------------ boshqaruv paneli
# /boshqaruv — foydalanuvchilar va o'quv statistikasi.
#
# BO'SH BO'LSA PANEL UMUMAN OCHILMAYDI (404). Bu ataylab: himoyasiz panel
# butun foydalanuvchilar ro'yxatini internetga chiqarardi.
#
# Kirishning yagona yo'li — Telegram. Parol yo'q va bo'lmaydi: o'zgarmas
# sir bir marta sizib chiqsa (jurnal, skrinshot, eski .env nusxasi) panel
# ochiq qoladi va buni hech kim sezmaydi. Havola esa 10 daqiqada o'ladi.

# Administratorlarning Telegram id'lari, vergul bilan.
# Shu ro'yxatdagi odam botga /boshqaruv yozsa, bot kirish havolasini yuboradi.
# O'z id'ingizni bilish uchun: botga /start yozing va server jurnaliga qarang.
#   ADMIN_TG_IDS=973358587
ADMIN_TG_IDS=

# ---------------------------------------------------------------- HTTPS
# Bularning hammasi standart holatda o'chiq. HTTPS ulanganidan KEYIN yoqing.

# nginx / Cloudflare ortida ishlayaptimi. Busiz Django so'rovni HTTP deb
# biladi va SSL_MAJBURIY yoqilsa cheksiz qayta yo'naltirish bo'ladi.
# PROKSI_ORTIDA=1

# HTTP so'rovni HTTPS ga yo'naltirish (odatda buni nginx bajaradi)
# SSL_MAJBURIY=1

# HSTS. EHTIYOT: brauzer buni ESLAB QOLADI va shu muddat davomida saytga
# HTTP bilan umuman kirmaydi. Sertifikat buzilsa sayt ochilmay qoladi.
# Avval kichik qiymat bilan sinang (3600 = 1 soat), keyin oshiring.
# HSTS_SEKUND=3600
# HSTS_SUBDOMEN=0
# HSTS_PRELOAD=0

# Telefon raqami shu SANADAN keyin ochilgan hisoblar uchun majburiy
# bo'ladi (YYYY-MM-DD). Undan oldingilar avvalgidek ishlaydi va
# ulardan raqam keyinroq, e'lon orqali so'raladi.
#
# Bo'sh qoldirilsa raqam hech kimga majburiy bo'lmaydi.
RAQAM_MAJBURIY_DAN=
