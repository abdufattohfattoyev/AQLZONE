{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "aql-zone-api",
      "runtimeExecutable": "backend/.venv/Scripts/python.exe",
      "runtimeArgs": ["backend/manage.py", "runserver", "8787"],
      "port": 8787
    },
    {
      "name": "afisha",
      "cwd": ".afisha",
