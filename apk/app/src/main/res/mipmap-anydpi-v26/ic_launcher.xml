<?xml version="1.0" encoding="utf-8"?>
<!--
    Moslashuvchan ikonka (Android 8+).

    Ikki qatlam: fon va belgi. Tizim ikkalasini o'zi kesadi va
    telefonning shakliga moslaydi — shuning uchun bu yerda doira ham,
    burchak ham chizilmaydi.

    Android 7 va undan pastda bu fayl ishlatilmaydi: u yerda
    `mipmap-*dpi/ic_launcher.png` ishlaydi.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ikonka_fon" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
