<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Android 8.1 dan boshlab pastdagi tizim panelining belgilarini
        ham qoraytirish mumkin. Undan oldingi versiyalarda bu imkoniyat
        yo'q edi va panel oq fonda oq chiziq bo'lib turardi.
    -->
    <style name="AqlZoneTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/splash</item>
        <item name="android:statusBarColor">@color/brend_fon</item>
        <item name="android:navigationBarColor">@color/brend_fon</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
