<?xml version="1.0" encoding="utf-8"?>
<!--
    Aql Zone belgisi — `frontend/public/logo.svg` ning Android nusxasi.

    2026-10-08 dan: firuza plitka, unda yonma-yon oq "A" va amber "Z"
    (ilgari shapka + "A" + ochiq kitob edi). Yo'llar (`pathData`) SVG
    dagi bilan AYNAN bir xil. Biri tuzatilsa, ikkalasi birga tuzatilishi
    kerak.

    Animatsiya yo'q: ikonka va splash uchun u kerak emas.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="120dp"
    android:height="120dp"
    android:viewportWidth="120"
    android:viewportHeight="120">

    <!-- Plitka: 120×120, burchak radiusi 28 -->
    <path android:pathData="M28 0H92A28 28 0 0 1 120 28V92A28 28 0 0 1 92 120H28A28 28 0 0 1 0 92V28A28 28 0 0 1 28 0Z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear"
                android:startX="0" android:startY="0" android:endX="120" android:endY="120">
                <item android:offset="0" android:color="#FF2CC6D4" />
                <item android:offset="0.55" android:color="#FF17B3C1" />
                <item android:offset="1" android:color="#FF0E8F9B" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Z — orqada (A uni pastda yopib turadi): soya, keyin tana -->
    <group android:translateX="1.4" android:translateY="3">
        <path android:pathData="M63 32 H98 L65 88 H101"
            android:strokeColor="#998A4B00" android:strokeWidth="11"
            android:strokeLineCap="round" android:strokeLineJoin="round" />
    </group>
    <path android:pathData="M63 32 H98 L65 88 H101"
        android:strokeWidth="11" android:strokeLineCap="round" android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient android:type="linear"
                android:startX="63" android:startY="32" android:endX="101" android:endY="88">
                <item android:offset="0" android:color="#FFFFB84D" />
                <item android:offset="1" android:color="#FFD97706" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- A — doimiy qism: soya, keyin tana -->
    <group android:translateX="1.4" android:translateY="3">
        <path android:pathData="M19 88 L42 30 L65 88 M30 69 H54"
            android:strokeColor="#8C08636B" android:strokeWidth="11"
            android:strokeLineCap="round" android:strokeLineJoin="round" />
    </group>
    <path android:pathData="M19 88 L42 30 L65 88 M30 69 H54"
        android:strokeColor="#FFFFFFFF" android:strokeWidth="11"
        android:strokeLineCap="round" android:strokeLineJoin="round" />
</vector>
