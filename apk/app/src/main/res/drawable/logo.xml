<?xml version="1.0" encoding="utf-8"?>
<!--
    Aql Zone belgisi — `frontend/public/logo.svg` ning Android nusxasi.

    Uch qism: akademik shapka (bilim), "A" harfi (Aql), ochiq kitob
    (ta'lim). Yo'llar (`pathData`) SVG dagi bilan AYNAN bir xil —
    ko'chirishda o'zgartirilmagan. Biri tuzatilsa, ikkalasi birga
    tuzatilishi kerak.

    Animatsiya yo'q: ikonka va splash uchun u kerak emas, VectorDrawable
    esa uni baribir ko'tarmaydi.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="120dp"
    android:height="120dp"
    android:viewportWidth="120"
    android:viewportHeight="120">

    <!-- Shapka: A'ning uchini yopib turadi, shuning uchun A'dan
         OLDIN chiziladi. -->
    <group
        android:name="shapka"
        android:pivotX="60"
        android:pivotY="24"
        android:rotation="-13">

        <path android:pathData="M60 6 96 22 60 38 24 22Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="24" android:startY="6"
                    android:endX="96" android:endY="38"
                    android:type="linear">
                    <item android:offset="0" android:color="#1e3a8f" />
                    <item android:offset="1" android:color="#101f52" />
                </gradient>
            </aapt:attr>
        </path>

        <path
            android:pathData="M48 29v9c0 3.4 5.4 6 12 6s12-2.6 12-6v-9l-12 5.3z"
            android:fillColor="#16295e" />

        <path
            android:pathData="M93.5 22.6v16"
            android:strokeColor="#101f52"
            android:strokeWidth="2.6"
            android:strokeLineCap="round" />

        <path
            android:pathData="M93.5 37c3.4 0 5.6 2 5.6 4.6 0 3.4-2.4 7-5.6 8.6-3.2-1.6-5.6-5.2-5.6-8.6 0-2.6 2.2-4.6 5.6-4.6z"
            android:fillColor="#16295e" />
    </group>

    <!-- "A": tashqi uchburchak MINUS ikkita teshik.
         `evenOdd` shu ishni qiladi — SVG da buni `clip-rule` qilardi. -->
    <path
        android:pathData="M60 28 L109 100 H11 Z M60 58 L71.5 75 H48.5 Z M44 83 H76 L80.5 91 H39.5 Z"
        android:fillType="evenOdd">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="11" android:startY="30"
                android:endX="109" android:endY="100"
                android:type="linear">
                <item android:offset="0" android:color="#2f7fe4" />
                <item android:offset="0.55" android:color="#2f8ee6" />
                <item android:offset="1" android:color="#22bd6d" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Ochiq kitob: A shu yerda "turadi" -->
    <path
        android:pathData="M4 98c17-9 39-8 54 2v13c-15-10-37-11-54-4z"
        android:fillColor="#1b45a8" />
    <path
        android:pathData="M116 98c-17-9-39-8-54 2v13c15-10 37-11 54-4z"
        android:fillColor="#1b45a8" />
    <path
        android:pathData="M8 96c16-7 36-6 50 3"
        android:strokeColor="#ffffff"
        android:strokeWidth="2.4"
        android:strokeLineCap="round" />
    <path
        android:pathData="M112 96c-16-7-36-6-50 3"
        android:strokeColor="#ffffff"
        android:strokeWidth="2.4"
        android:strokeLineCap="round" />
</vector>
