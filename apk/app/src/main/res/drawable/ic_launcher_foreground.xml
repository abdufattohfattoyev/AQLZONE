<?xml version="1.0" encoding="utf-8"?>
<!--
    Ikonkaning old qatlami (Android 8 va undan yuqori).

    Tizim ikonkani DOIRA, kvadrat yoki squircle qilib KESADI va kesish
    chizig'i qayerdan o'tishini oldindan bilib bo'lmaydi. Shuning uchun
    harflar 108×108 maydonning markazida, xavfsiz zonada (66dp) turadi.
    Firuza fon — orqa qatlam (`@color/ikonka_fon`).

    Yo'llar `drawable/logo.xml` (= `frontend/public/logo.svg`) dagi bilan bir xil.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Harflar 120-to'rda x:17..103, y:24..95 → 0.62 masshtab, markazga -->
    <group
        android:scaleX="0.62"
        android:scaleY="0.62"
        android:translateX="16.8"
        android:translateY="17.4">

        <group android:translateX="1.4" android:translateY="3">
            <path android:pathData="M63 32 H98 L65 88 H101"
                android:strokeColor="#998A4B00" android:strokeWidth="11"
                android:strokeLineCap="round" android:strokeLineJoin="round" />
        </group>
        <path android:pathData="M63 32 H98 L65 88 H101"
            android:strokeWidth="11" android:strokeLineCap="round" android:strokeLineJoin="round">
            <aapt:attr name="android:strokeColor">
                <gradient android:type="linear"
                    android:startX="63" android:startY="32" android:endX="101" android:endY="88">
                    <item android:offset="0" android:color="#FFFFB84D" />
                    <item android:offset="1" android:color="#FFD97706" />
                </gradient>
            </aapt:attr>
        </path>

        <group android:translateX="1.4" android:translateY="3">
            <path android:pathData="M19 88 L42 30 L65 88 M30 69 H54"
                android:strokeColor="#8C08636B" android:strokeWidth="11"
                android:strokeLineCap="round" android:strokeLineJoin="round" />
        </group>
        <path android:pathData="M19 88 L42 30 L65 88 M30 69 H54"
            android:strokeColor="#FFFFFFFF" android:strokeWidth="11"
            android:strokeLineCap="round" android:strokeLineJoin="round" />
    </group>
</vector>
