# Bog'liqliklar va yig'ilgan fayllar
node_modules/
dist/
.venv/
__pycache__/
*.pyc

# Maxfiy sozlamalar — hech qachon git'ga tushmasin
.env

# Claude Code shaxsiy sozlamalari (ruxsatlar, mahalliy yo'llar)
.claude/settings.local.json

# Ma'lumotlar bazasi (foydalanuvchi progressi)
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm

# Yasalgan ovoz fayllari (TTS keshi). Ular kod emas, NATIJA: har
# serverda o'zi to'ldiriladi (`manage.py ovoz`) va git'da o'nlab
# megabayt joy egallardi.
ovoz-kesh/

# Foydalanuvchi yuborgan rasmlar. Kod emas va git'ga tushmasligi
# kerak: serverda ular volume ichida yotadi.
media/

# Arxivlar
*.rar
*.zip

# Muharrir
.DS_Store
*.swp

# Rolik ustaxonasi — ekran suratlari, ovoz, yasalgan video.
# Kod emas, NATIJA: kerak bo`lsa `.rolik/` ichidagi skriptlar bilan
# qaytadan yasaladi va git`da o`nlab megabayt joy egallardi.
.rolik/

# Higgsfield asboblari — `npx skills add higgsfield-ai/skills` qo`ygan
# ko`nikmalar va ularning qulfi. Kod emas, ASBOB: har dasturchi o`zi
# o`rnatadi va versiyasi mashinasiga bog`liq bo`ladi.
.agents/
.claude/skills/
skills-lock.json

# Ko`z bilan tekshirish uchun vaqtinchalik sahifalar.
.afisha/*.html
frontend/belgilar.html
frontend/src/belgiSinov.tsx
emoji-royxat.txt

# Higgsfield chizgan xom varaqlar va kesish skripti. Natija
# `frontend/public/belgi/` ga tushadi — xom fayl 3-4 MB va uni
# saqlashning ma'nosi yo`q.
.belgi/
